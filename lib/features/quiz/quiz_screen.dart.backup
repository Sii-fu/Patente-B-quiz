import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:supabase_flutter/supabase_flutter.dart';
import 'package:provider/provider.dart';
import 'package:cached_network_image/cached_network_image.dart';
import '../../l10n/app_localizations.dart';
import '../../models/question.dart';
import '../../models/quiz_session.dart';
import '../../providers/language_provider.dart';
import '../../services/quiz_service.dart';
import 'result_screen.dart';

class QuizScreen extends StatefulWidget {
  final bool isExamMode;
  final QuizMode quizMode;

  const QuizScreen({
    super.key,
    this.isExamMode = true,
    this.quizMode = QuizMode.simulation,
  });

  @override
  State<QuizScreen> createState() => _QuizScreenState();
}

class _QuizScreenState extends State<QuizScreen> {
  final PageController _pageController = PageController();
  final QuizService _quizService = QuizService();
  
  List<Question> _questions = [];
  Map<int, bool> _userAnswers = {};  // questionIndex -> selectedTrue
  bool _isLoading = true;
  String? _error;
  
  // Timer
  late Timer _timer;
  int _secondsRemaining = 20 * 60; // 20 minutes
  DateTime? _startTime;
  
  // Language for question display (cycles through it -> bn -> en)
  String _currentQuestionLanguage = 'it'; // Always start with Italian
  int _currentPage = 0;

  @override
  void initState() {
    super.initState();
    _startTime = DateTime.now();
    _loadQuestions();
    _startTimer();
  }

  @override
  void dispose() {
    _timer.cancel();
    _pageController.dispose();
    super.dispose();
  }

  void _startTimer() {
    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      if (_secondsRemaining > 0) {
        setState(() => _secondsRemaining--);
      } else {
        _timer.cancel();
        _autoSubmitQuiz();
      }
    });
  }

  Future<void> _loadQuestions() async {
    try {
      setState(() => _isLoading = true);

      final questions = await _quizService.fetchRandomQuestions(count: 30);

      setState(() {
        _questions = questions;
        _isLoading = false;
      });
    } catch (e) {
      setState(() {
        _error = e.toString();
        _isLoading = false;
      });
    }
  }

  void _answerQuestion(int questionIndex, bool selectedTrue) {
    HapticFeedback.mediumImpact();
    
    setState(() {
      _userAnswers[questionIndex] = selectedTrue;
    });

    // Training mode: show instant feedback
    if (!widget.isExamMode) {
      final isCorrect = _questions[questionIndex].isTrue == selectedTrue;
      
      // Visual feedback
      ScaffoldMessenger.of(context).clearSnackBars();
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(isCorrect ? '✓ Correct!' : '✗ Incorrect'),
          backgroundColor: isCorrect ? Colors.green : Colors.red,
          duration: const Duration(seconds: 1),
        ),
      );
    }

    // Auto-advance after a brief delay
    Future.delayed(const Duration(milliseconds: 500), () {
      if (questionIndex < _questions.length - 1) {
        _pageController.nextPage(
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeInOut,
        );
      }
    });
  }

  void _autoSubmitQuiz() {
    final l10n = AppLocalizations.of(context)!;
    
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(l10n.quizTimeUp),
        backgroundColor: Colors.red,
      ),
    );

    Future.delayed(const Duration(seconds: 1), _submitQuiz);
  }

  Future<void> _submitQuiz() async {
    final l10n = AppLocalizations.of(context)!;
    final user = Supabase.instance.client.auth.currentUser;
    
    if (user == null) return;

    // Calculate results
    int errorsCount = 0;
    for (int i = 0; i < _questions.length; i++) {
      final userAnswer = _userAnswers[i];
      if (userAnswer == null) {
        errorsCount++; // Unanswered counts as error
      } else if (userAnswer != _questions[i].isTrue) {
        errorsCount++;
      }
    }

    final correctCount = _questions.length - errorsCount;
    final isPassed = errorsCount <= 4; // Max 4 errors allowed
    final durationSeconds = (20 * 60) - _secondsRemaining;

    // Navigate to result screen
    Navigator.pushReplacement(
      context,
      MaterialPageRoute(
        builder: (context) => ResultScreen(
          questions: _questions,
          userAnswers: _userAnswers,
          correctCount: correctCount,
          errorsCount: errorsCount,
          isPassed: isPassed,
          durationSeconds: durationSeconds,
          quizMode: widget.quizMode,
        ),
      ),
    );
  }

  void _showSubmitConfirmation() async {
    final l10n = AppLocalizations.of(context)!;
    final answeredCount = _userAnswers.length;
    final totalCount = _questions.length;

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(l10n.quizSubmitConfirm),
        content: Text(
          '${l10n.quizSubmitMessage} $answeredCount ${l10n.quizSubmitOutOf} $totalCount ${l10n.quizSubmitQuestions}',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: Text(l10n.profileCancel),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(context, true),
            child: Text(l10n.profileConfirm),
          ),
        ],
      ),
    );

    if (confirmed == true) {
      await _submitQuiz();
    }
  }

  void _showBackConfirmation() async {
    final l10n = AppLocalizations.of(context)!;

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: Text(l10n.quizBackConfirm),
        content: Text(l10n.quizBackMessage),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: Text(l10n.profileCancel),
          ),
          FilledButton(
            onPressed: () {
              HapticFeedback.mediumImpact();
              Navigator.pop(context, true);
            },
            style: FilledButton.styleFrom(
              backgroundColor: Colors.red,
            ),
            child: Text(l10n.profileConfirm),
          ),
        ],
      ),
    );

    if (confirmed == true && mounted) {
      Navigator.pop(context);
    }
  }

  void _showImageDialog(String imageUrl) {
    final l10n = AppLocalizations.of(context)!;
    
    showDialog(
      context: context,
      builder: (context) => Dialog(
        backgroundColor: Colors.black,
        child: Stack(
          children: [
            InteractiveViewer(
              panEnabled: true,
              boundaryMargin: const EdgeInsets.all(20),
              minScale: 0.5,
              maxScale: 4,
              child: CachedNetworkImage(
                imageUrl: imageUrl,
                fit: BoxFit.contain,
                placeholder: (context, url) => const Center(
                  child: CircularProgressIndicator(),
                ),
                errorWidget: (context, url, error) => Center(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Icon(Icons.error_outline, color: Colors.white, size: 64),
                      const SizedBox(height: 16),
                      Text(
                        l10n.quizImageError,
                        style: const TextStyle(color: Colors.white),
                      ),
                    ],
                  ),
                ),
              ),
            ),
            Positioned(
              top: 16,
              right: 16,
              child: IconButton(
                icon: const Icon(Icons.close, color: Colors.white, size: 32),
                onPressed: () => Navigator.pop(context),
              ),
            ),
          ],
        ),
      ),
    );
  }

  void _switchQuestionLanguage() {
    HapticFeedback.lightImpact();
    setState(() {
      // Cycle through: it -> bn -> en -> it
      if (_currentQuestionLanguage == 'it') {
        _currentQuestionLanguage = 'bn';
      } else if (_currentQuestionLanguage == 'bn') {
        _currentQuestionLanguage = 'en';
      } else {
        _currentQuestionLanguage = 'it';
      }
    });
  }

  void _playTextToSpeech() {
    HapticFeedback.mediumImpact();
    // TODO: Implement TTS functionality
    final l10n = AppLocalizations.of(context)!;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('${l10n.quizTextToSpeech} (Coming Soon)'),
        duration: const Duration(seconds: 1),
      ),
    );
  }

  String _formatTime(int seconds) {
    final minutes = seconds ~/ 60;
    final secs = seconds % 60;
    return '${minutes.toString().padLeft(2, '0')}:${secs.toString().padLeft(2, '0')}';
  }

  String _getLanguageName(String code, AppLocalizations l10n) {
    switch (code) {
      case 'it':
        return l10n.quizItalian;
      case 'en':
        return l10n.quizEnglish;
      case 'bn':
        return l10n.quizBangla;
      default:
        return l10n.quizItalian;
    }
  }

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    final theme = Theme.of(context);
    final languageProvider = Provider.of<LanguageProvider>(context);
    final currentLanguage = languageProvider.locale.languageCode;

    if (_isLoading) {
      return Scaffold(
        appBar: AppBar(title: Text(l10n.quizTitle)),
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const CircularProgressIndicator(),
              const SizedBox(height: 16),
              Text(l10n.quizLoading),
            ],
          ),
        ),
      );
    }

    if (_error != null || _questions.isEmpty) {
      return Scaffold(
        appBar: AppBar(title: Text(l10n.quizTitle)),
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(Icons.error_outline, size: 64, color: theme.colorScheme.error),
              const SizedBox(height: 16),
              Text(_error ?? l10n.quizNoQuestions),
            ],
          ),
        ),
      );
    }

    return Scaffold(
      appBar: AppBar(
        title: Text('${l10n.quizQuestion} ${_currentPage + 1} ${l10n.quizOf} ${_questions.length}'),
        actions: [
          // Language toggle
          IconButton(
            icon: Icon(_showTranslation ? Icons.translate : Icons.translate_outlined),
            tooltip: _showTranslation ? l10n.quizOriginal : l10n.quizTranslate,
            onPressed: () {
              HapticFeedback.mediumImpact();
              setState(() => _showTranslation = !_showTranslation);
            },
          ),
          // Timer
          Container(
            margin: const EdgeInsets.symmetric(horizontal: 8, vertical: 12),
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
            decoration: BoxDecoration(
              color: _secondsRemaining < 300
                  ? Colors.red.withOpacity(0.2)
                  : theme.colorScheme.primary.withOpacity(0.2),
              borderRadius: BorderRadius.circular(20),
            ),
            child: Row(
              children: [
                Icon(
                  Icons.timer_outlined,
                  size: 18,
                  color: _secondsRemaining < 300 ? Colors.red : theme.colorScheme.primary,
                ),
                const SizedBox(width: 4),
                Text(
                  _formatTime(_secondsRemaining),
                  style: TextStyle(
                    fontWeight: FontWeight.bold,
                    color: _secondsRemaining < 300 ? Colors.red : theme.colorScheme.primary,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
      body: Column(
        children: [
          // Progress indicator
          LinearProgressIndicator(
            value: _userAnswers.length / _questions.length,
            minHeight: 4,
          ),
          
          Expanded(
            child: PageView.builder(
              controller: _pageController,
              onPageChanged: (index) {
                setState(() => _currentPage = index);
              },
              itemCount: _questions.length,
              itemBuilder: (context, index) {
                final question = _questions[index];
                final userAnswer = _userAnswers[index];
                final questionText = _showTranslation
                    ? question.getText(currentLanguage)
                    : question.textIt;

                return SingleChildScrollView(
                  padding: const EdgeInsets.all(20),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      // Question Image
                      if (question.imageUrl != null) ...[
                        GestureDetector(
                          onTap: () => _showImageDialog(question.imageUrl!),
                          child: Container(
                            height: 200,
                            decoration: BoxDecoration(
                              borderRadius: BorderRadius.circular(12),
                              border: Border.all(
                                color: theme.colorScheme.outline.withOpacity(0.3),
                              ),
                            ),
                            child: ClipRRect(
                              borderRadius: BorderRadius.circular(12),
                              child: Stack(
                                fit: StackFit.expand,
                                children: [
                                  Image.network(
                                    question.imageUrl!,
                                    fit: BoxFit.cover,
                                  ),
                                  Positioned(
                                    bottom: 8,
                                    right: 8,
                                    child: Container(
                                      padding: const EdgeInsets.symmetric(
                                        horizontal: 8,
                                        vertical: 4,
                                      ),
                                      decoration: BoxDecoration(
                                        color: Colors.black54,
                                        borderRadius: BorderRadius.circular(12),
                                      ),
                                      child: Row(
                                        mainAxisSize: MainAxisSize.min,
                                        children: [
                                          const Icon(
                                            Icons.zoom_in,
                                            color: Colors.white,
                                            size: 16,
                                          ),
                                          const SizedBox(width: 4),
                                          Text(
                                            l10n.quizTapToZoom,
                                            style: const TextStyle(
                                              color: Colors.white,
                                              fontSize: 12,
                                            ),
                                          ),
                                        ],
                                      ),
                                    ),
                                  ),
                                ],
                              ),
                            ),
                          ),
                        ),
                        const SizedBox(height: 24),
                      ],

                      // Question Text
                      Text(
                        questionText,
                        style: theme.textTheme.headlineSmall?.copyWith(
                          fontWeight: FontWeight.w600,
                          height: 1.4,
                        ),
                      ),

                      const SizedBox(height: 32),

                      // Answer Buttons
                      _buildAnswerButton(
                        context: context,
                        isTrue: true,
                        label: l10n.quizTrue,
                        isSelected: userAnswer == true,
                        onTap: () => _answerQuestion(index, true),
                        theme: theme,
                      ),

                      const SizedBox(height: 16),

                      _buildAnswerButton(
                        context: context,
                        isTrue: false,
                        label: l10n.quizFalse,
                        isSelected: userAnswer == false,
                        onTap: () => _answerQuestion(index, false),
                        theme: theme,
                      ),

                      const SizedBox(height: 32),

                      // Answer status
                      Text(
                        userAnswer != null ? l10n.quizAnswered : l10n.quizUnanswered,
                        style: theme.textTheme.bodySmall?.copyWith(
                          color: userAnswer != null
                              ? Colors.green
                              : theme.colorScheme.onSurface.withOpacity(0.5),
                          fontWeight: FontWeight.w600,
                        ),
                        textAlign: TextAlign.center,
                      ),
                    ],
                  ),
                );
              },
            ),
          ),

          // Submit Button
          SafeArea(
            child: Padding(
              padding: const EdgeInsets.all(16.0),
              child: FilledButton.icon(
                onPressed: _showSubmitConfirmation,
                icon: const Icon(Icons.check_circle_outline),
                label: Text(l10n.quizSubmit),
                style: FilledButton.styleFrom(
                  padding: const EdgeInsets.symmetric(vertical: 16),
                  minimumSize: const Size(double.infinity, 0),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildAnswerButton({
    required BuildContext context,
    required bool isTrue,
    required String label,
    required bool isSelected,
    required VoidCallback onTap,
    required ThemeData theme,
  }) {
    final color = isTrue ? Colors.green : Colors.red;

    return Material(
      color: isSelected
          ? color.withOpacity(0.2)
          : theme.colorScheme.surface,
      borderRadius: BorderRadius.circular(16),
      elevation: isSelected ? 4 : 1,
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(16),
        child: Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(16),
            border: Border.all(
              color: isSelected ? color : theme.colorScheme.outline.withOpacity(0.3),
              width: isSelected ? 3 : 1,
            ),
          ),
          child: Row(
            children: [
              Container(
                width: 32,
                height: 32,
                decoration: BoxDecoration(
                  color: isSelected ? color : color.withOpacity(0.1),
                  shape: BoxShape.circle,
                ),
                child: Icon(
                  isSelected ? Icons.check_circle : Icons.circle_outlined,
                  color: isSelected ? Colors.white : color,
                  size: 20,
                ),
              ),
              const SizedBox(width: 16),
              Text(
                label,
                style: theme.textTheme.titleLarge?.copyWith(
                  fontWeight: FontWeight.bold,
                  color: isSelected ? color : theme.colorScheme.onSurface,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
