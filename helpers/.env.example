# ==========================================
# Helpers - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!

# Supabase Credentials (Service Role Key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# HuggingFace Token (for sentence-transformers API)
HF_TOKEN=hf_your-token-here

# HuggingFace Inference API URL
HF_API_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2
